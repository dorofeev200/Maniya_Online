NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://plugin.maniya-kvn.online
CORS_ORIGINS=https://plugin.maniya-kvn.online
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TOKEN_MIN_LENGTH=8
SHUTDOWN_TIMEOUT_MS=10000
# USERS_FILE=/secure/maniya/users.json
# VIDEOS_FILE=/secure/maniya/videos.json
# PUBLIC_DIR=/opt/maniya-online/public

# --- Filmix ---
# Бесплатный путь работает без токена (качество до 720p).
# FILMIX_ENABLED=1
# FILMIX_PRO=0
# FILMIX_HLS=0
# FILMIX_HOST=https://filmix.my
# FILMIX_TV_HOST=https://api.filmix.tv

# --- Прокси потоков (обход CORS для браузера) ---
# Разрешённые хосты-источники для /api/lampa/proxy (SSRF-локлист).
# Запись разрешает и все её поддомены. CDN-хосты (werkecdn.me, cdnsqu.com)
# нужны для потоков из browser-API video-links; kodikres.com — для Kodik.
# PROXY_ALLOW_HOSTS=filmix.my,filmix.gg,filmix.tv,filmix.pub,filmix.fm,filmix.ac,werkecdn.me,cdnsqu.com,kodikres.com
# PROXY_TIMEOUT_MS=15000
# PROXY_MAX_REDIRECTS=4
