NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://plugin.maniya-kvn.online
# CORS для устройств Лampa (Origin может быть null/другой). Открываем — авторизация через токен.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TOKEN_MIN_LENGTH=8
SHUTDOWN_TIMEOUT_MS=10000
# USERS_FILE=/secure/maniya/users.json
# VIDEOS_FILE=/secure/maniya/videos.json
# PUBLIC_DIR=/opt/maniya-online/public

# --- Telegram-бот (авто-выдача подписок) ---
# Модель: триал по /start (TELEGRAM_TRIAL_DAYS дней) + ручная выдача/продление
# командой /grant <token> [days] из админ-чата (TELEGRAM_ADMINS).
# Бот отдаёт ссылку плагина с токеном — пользователь добавляет в Lampa.
# Ответ бота: баннер-бренд + «осталось N дней» + ссылка + inline-кнопки
# [🎬 Получить ссылку] и [📩 Связь с админом] (если задан TELEGRAM_ADMIN_CONTACT).
# Без TELEGRAM_BOT_TOKEN polling не стартует (сервер продолжает работать).
# TELEGRAM_ENABLED=1
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMINS=123456789
# TELEGRAM_TRIAL_DAYS=3
# TELEGRAM_TRIAL_PLAN=trial
# TELEGRAM_POLL_TIMEOUT=60
# TELEGRAM_API_BASE=https://api.telegram.org
# Короткая ссылка: /{prefix}_{short}.js (сервер вшивает токен в плагин).
# Подстановки: {token}, {short} (суффикс токена), {slug} (ник пользователя),
# {prefix} из TELEGRAM_LINK_PREFIX. {slug} даёт видимо-уникальную ссылку с ником;
# если в шаблоне нет {slug}, сервер внедряет ник сам после префикса.
# TELEGRAM_PLUGIN_URL=https://plugin.maniya-kvn.online/dorofeev200_{slug}_{short}.js
# TELEGRAM_LINK_PREFIX=dorofeev200
# TELEGRAM_BANNER=🎬 MANIYA ONLINE — ваш кино-плагин для Lampa 🎬
# TELEGRAM_ADMIN_CONTACT=https://t.me/your_admin_username
# Реквизиты оплаты → кнопка «💳 Оплатить». Пусто → секции оплаты нет.
# TELEGRAM_PAYMENT_DETAILS=Карта 2200 0000 0000 0000 (Т-Банк). Оплата 1 мес — 299 ₽

# --- Filmix ---
# Бесплатный путь работает без токена (качество до 720p).
# FILMIX_ENABLED=1
# FILMIX_PRO=0
# FILMIX_HLS=0
# FILMIX_HOST=https://filmix.my
# FILMIX_TV_HOST=https://api.filmix.tv

# --- Collaps ---
# Публичный токен. Без COLLAPS_TOKEN провайдер скрыт (enabled()=false).
# COLLAPS_ENABLED=1
# COLLAPS_API_HOST=https://api.bhcesh.me
# COLLAPS_EMBED_HOST=https://api.ortified.ws
# COLLAPS_TOKEN=

# --- HDVB ---
# Публичный токен (как в Lampac ModInit). Без HDVB_TOKEN провайдер скрыт.
# HDVB_ENABLED=1
# HDVB_API_HOST=https://apivb.com
# HDVB_FRAME_HOST=https://vid1733431681.entouaedon.com
# HDVB_REFERER=https://movielab.one
# HDVB_TOKEN=

# --- E-Online (источники «Maniya») ---
# Авторизация = account_email + uid в URL (без memkey/aesgcm); Origin: http://lampa.mx
# на потоки skaz/voidboost. Каждый балансер из EO_BALANCERS — отдельный источник.
# Дефолт — только live-зелёные (test/eolive.test.js, EO_LIVE=1). Мёртвые (503/timeout/
# no-content) в дефолт не входят; расширяется их список аккаунта.
# Аккаунт заполняется только в server/.env (никогда не коммитим сюда!).
# EO_ENABLED=1
# EO_BALANCERS=filmix,rezka,videoseed,kinoflix,pidtor,solntse

# --- Прокси потоков (обход CORS для браузера) ---
# Разрешённые хосты-источники для /api/lampa/proxy (SSRF-локлист).
# Запись разрешает и все её поддомены. CDN-хосты (werkecdn.it, cdnsqu.com)
# нужны для потоков из browser-API video-links; kodikres.com — Kodik;
# sevstar933krop.com, entouaedon.com — HDVB (m3u8 + сегменты).
# PROXY_ALLOW_HOSTS=filmix.my,filmix.gg,filmix.tv,filmix.pub,filmix.fm,filmix.ac,werkecdn.it,cdnsqu.com,kodikres.com,sevstar933krop.com,entouaedon.com
# http-хосты (без TLS) — отдельный узкий список (E-Online + voidboost HLS).
# PROXY_HTTP_ALLOW_HOSTS=94.249.239.63,94.249.239.37,94.249.239.11,77.90.33.109,skaz.tv,voidboost.one,voidboost.com
# PROXY_TIMEOUT_MS=15000
# PROXY_MAX_REDIRECTS=4
