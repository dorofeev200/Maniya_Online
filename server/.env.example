NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://plugin.maniya-kvn.online
CORS_ORIGINS=https://plugin.maniya-kvn.online
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TOKEN_MIN_LENGTH=8

# --- Filmix ---
# FILMIX_ENABLED=1
# FILMIX_PRO=0
# FILMIX_HLS=0
# FILMIX_HOST=https://filmix.my
# FILMIX_TV_HOST=https://api.filmix.tv
# Устройство-токен (бесплатный путь до 720p без FILMIX_PRO).
# Выдаётся интерактивно на https://filmix.my/consoles — нельзя получить автоматически.
# FILMIX_TOKEN=

# --- RutubeMovie ---
# Открытый фильм-поиск через Rutube API. Без токена. Adaptive HLS (quality "auto").
# RUTUBEMOVIE_ENABLED=1
# RUTUBE_HOST=https://rutube.ru
# CDN-хосты потоков Rutube (rutube.ru, rtbcdn.ru) добавляются в proxy.allowHosts
# автоматически.

# --- CDNvideohub (VideoHUB) ---
# Плеерное API по kinopoisk_id (поиска по названию нет — работает только для
# карточек с kp). Adaptive HLS, без токена. CDN-хосты потоков (vkuser.net,
# okcdn.ru) добавляются в proxy.allowHosts автоматически.
# CDNVIDEOHUB_ENABLED=1
# CDNVIDEOHUB_HOST=https://plapi.cdnvideohub.com

# --- Collaps ---
# HTML+JSON (как Lampac OnlineRUS/Collaps). Поиск /list, embed-страница плеера
# (источник фильма или seasons-блок сериала). Потоки interkh.com — через наш
# прокси. Публичный токен зашит в Lampac, вынесен в config; задайте для live:
# COLLAPS_ENABLED=1
# COLLAPS_API_HOST=https://api.bhcesh.me
# COLLAPS_EMBED_HOST=https://api.ortified.ws
# COLLAPS_TOKEN=

# --- Rezka ---
# REZKA_ENABLED=1
# REZKA_BASE_URL=https://rezka.ag
# Premium-доступ: без логина — бесплатные потоки.
# REZKA_LOGIN=
# REZKA_PASSWORD=
# REZKA_PREMIUM=0
# REZKA_HLS=0
# CDN-хосты Rezka (помимо rezka.ag), разрешаемые в прокси потоков.
# По умолчанию: voidboost.one, voidboost.com, hdrezka.me (суффиксное
# сопоставление: voidboost.one покрывает stream./storm.stream.voidboost.one).
# Задайте здесь при смене CDN у Rezka.
# REZKA_ALLOW_HOSTS=stream.voidboost.one,static.voidboost.com

# --- Kodik ---
# Публичный токен Kodik-info (https://kodik.info/developer/). Без него
# провайдер скрыт из источников (enabled() = false).
# KODIK_ENABLED=1
# KODIK_TOKEN=
# Приватный secret_token включает прямой маршрут /api/video-links (HMAC)
# вместо парсинга страницы плеера. Их взять: https://rentbox.ru (или договорённость).
# KODIK_SECRET_TOKEN=
# KODIK_API_HOST=https://kodikapi.com
# KODIK_LINK_HOST=https://kodikres.com
# KODIK_PLAYER_HOST=https://kodikplayer.com

# --- Alloha ---
# Подписка Alloha: API требует Bearer-токен (ALLOHA_TOKEN) — без него поиск
# TOKEN_REQUIRED. Стримы идут через /direct на отдельном linkhost с secret_token
# (если не задан — берётся тот же токен). Без токена источник скрыт.
# ALLOHA_ENABLED=1
# ALLOHA_API_HOST=https://apbugall.org/v2
# ALLOHA_LINK_HOST=https://torso-as.stloadi.live
# ALLOHA_TOKEN=
# ALLOHA_SECRET_TOKEN=

# --- E-Online (источники «Maniya») ---
# Авторизация = account_email + uid в URL каждого запроса (без memkey/aesgcm);
# на потоки skaz/voidboost обязателен Origin: http://lampa.mx. Каждый балансер
# из EO_BALANCERS — отдельный источник «Maniya · <имя>». Без EO_ACCOUNT_EMAIL/UID
# источники скрыты. Аккаунт НЕ коммитить (здесь пусто!).
# EO_ENABLED=1
# EO_HOSTS=http://94.249.239.63,http://94.249.239.37,http://94.249.239.11,http://77.90.33.109
# EO_SKAZ_HOSTS=http://online3.skaz.tv,http://online8.skaz.tv
# EO_BALANCERS=alloha,videoseed,kinoflix,veoveo,pidtor,solntse
# EO_ACCOUNT_EMAIL=
# EO_UID=
# EO_ORIGIN=http://lampa.mx

# --- Skaz-кластер (Lampac-протокол, docs/skaz-architecture.md) ---
# Тот же источник, что E-Online, но живёт напрямую против skaz-кластера,
# НЕ зависит от E-Online-плагина. SKAZ_* — primary, старые EO_* автоматически
# используются как фолбэк (VPS server/.env с EO_* продолжает работать).
# SKAZ_ENABLED=1
# SKAZ_HOSTS=http://online3.skaz.tv,http://online8.skaz.tv,http://94.249.239.63,http://94.249.239.37,http://94.249.239.11,http://77.90.33.109
# SKAZ_BALANCERS=alloha,videoseed,kinopub,kinoflix,veoveo,pidtor,solntse,filmix,rezka,hdvb,rutubemovie,kodik,zagonka
# Авторизация — pair: SKAZ_ACCOUNT_EMAIL + SKAZ_UID (вход через Lampa
# «Настройки — Синхронизация», docs/skaz-architecture.md §6.5-§6.7). НЕ коммитить!
# SKAZ_ACCOUNT_EMAIL=
# SKAZ_UID=
# SKAZ_ORIGIN=http://lampa.mx

# --- Прокси потоков (обход CORS для браузера) ---
# Разрешённые хосты-источники для /api/lampa/proxy (SSRF-локлист;
# запись разрешает и все её поддомены). kodikres.com (Kodik) и rezka.ag
# (Rezka) добавляются в конфиг автоматически.
# PROXY_ALLOW_HOSTS=filmix.my,filmix.gg,filmix.tv,filmix.pub,filmix.fm,filmix.ac,werkecdn.me,cdnsqu.com,kodikres.com
# http-хосты (без TLS) — отдельный узкий список: E-Online (94.249.239.*,
# 77.90.33.109, skaz.tv) и CDN-манифест voidboost (HLS-сессии).
# PROXY_HTTP_ALLOW_HOSTS=94.249.239.63,94.249.239.37,94.249.239.11,77.90.33.109,skaz.tv,voidboost.one,voidboost.com
# PROXY_TIMEOUT_MS=15000
# PROXY_MAX_REDIRECTS=4
