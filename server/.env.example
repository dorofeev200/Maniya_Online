NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://plugin.maniya-kvn.online
CORS_ORIGINS=https://plugin.maniya-kvn.online
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TOKEN_MIN_LENGTH=8

# --- Filmix ---
# FILMIX_ENABLED=1
# FILMIX_PRO=0
# FILMIX_HLS=0
# FILMIX_HOST=https://filmix.my
# FILMIX_TV_HOST=https://api.filmix.tv
# Устройство-токен (бесплатный путь до 720p без FILMIX_PRO).
# Выдаётся интерактивно на https://filmix.my/consoles — нельзя получить автоматически.
# FILMIX_TOKEN=

# --- Rezka ---
# REZKA_ENABLED=1
# REZKA_BASE_URL=https://rezka.ag
# Premium-доступ: без логина — бесплатные потоки.
# REZKA_LOGIN=
# REZKA_PASSWORD=
# REZKA_PREMIUM=0
# REZKA_HLS=0
# CDN-хосты Rezka (помимо rezka.ag), разрешаемые в прокси потоков.
# По умолчанию: voidboost.one, voidboost.com, hdrezka.me (суффиксное
# сопоставление: voidboost.one покрывает stream./storm.stream.voidboost.one).
# Задайте здесь при смене CDN у Rezka.
# REZKA_ALLOW_HOSTS=stream.voidboost.one,static.voidboost.com

# --- Kodik ---
# Публичный токен Kodik-info (https://kodik.info/developer/). Без него
# провайдер скрыт из источников (enabled() = false).
# KODIK_ENABLED=1
# KODIK_TOKEN=
# Приватный secret_token включает прямой маршрут /api/video-links (HMAC)
# вместо парсинга страницы плеера. Их взять: https://rentbox.ru (или договорённость).
# KODIK_SECRET_TOKEN=
# KODIK_API_HOST=https://kodikapi.com
# KODIK_LINK_HOST=https://kodikres.com
# KODIK_PLAYER_HOST=https://kodikplayer.com

# --- Alloha ---
# Подписка Alloha: API требует Bearer-токен (ALLOHA_TOKEN) — без него поиск
# TOKEN_REQUIRED. Стримы идут через /direct на отдельном linkhost с secret_token
# (если не задан — берётся тот же токен). Без токена источник скрыт.
# ALLOHA_ENABLED=1
# ALLOHA_API_HOST=https://apbugall.org/v2
# ALLOHA_LINK_HOST=https://torso-as.stloadi.live
# ALLOHA_TOKEN=
# ALLOHA_SECRET_TOKEN=

# --- Прокси потоков (обход CORS для браузера) ---
# Разрешённые хосты-источники для /api/lampa/proxy (SSRF-локлист;
# запись разрешает и все её поддомены). kodikres.com (Kodik) и rezka.ag
# (Rezka) добавляются в конфиг автоматически.
# PROXY_ALLOW_HOSTS=filmix.my,filmix.gg,filmix.tv,filmix.pub,filmix.fm,filmix.ac,werkecdn.me,cdnsqu.com,kodikres.com
# PROXY_TIMEOUT_MS=15000
# PROXY_MAX_REDIRECTS=4
